# ==========================================
# EditMind — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves
# NUNCA commite o arquivo .env
# ==========================================

# OpenRouter (LLM - Brain Engine)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX

# URL base da API (ngrok para dev local, domínio real em produção)
API_BASE_URL=http://localhost:8000

# Pexels (B-Roll de imagens)
# Obtenha em: https://www.pexels.com/api/
PEXELS_API_KEY=

# Banco de Dados
# Desenvolvimento: deixe em branco para usar SQLite local (editmind.db)
# Produção: cole a connection string do Supabase/Railway/Render
# Formato PostgreSQL: postgresql://user:senha@host:porta/database
DATABASE_URL=
